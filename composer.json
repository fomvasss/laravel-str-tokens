{
    "name": "fomvasss/laravel-str-tokens",
    "description": "A package to manage and generate string with tokens/shortcodes for Eloquent Models",
    "type": "composer-package",
    "keywords": ["token", "tag", "string", "shortcodes", "laravel", "drupal"],
    "homepage": "https://github.com/fomvasss/laravel-str-tokens",
    "authors": [
        {
            "name": "Fomin Vasyl",
            "email": "fomvasss@gmail.com",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "funding": [
        {
            "type": "custom",
            "url": "https://send.monobank.ua/jar/5xsqtHvVrY"
        },
        {
            "type": "ko_fi",
            "url": "https://ko-fi.com/fomvasss"
        }
    ],
    "require": {
        "php" : "^8.0.2",
        "illuminate/support": "^9|^10|^11|^12|^13",
        "nesbot/carbon": "^2|^3"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Fomvasss\\LaravelStrTokens\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fomvasss\\LaravelStrTokens\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fomvasss\\LaravelStrTokens\\ServiceProvider"
            ],
            "aliases": {
                "StrToken": "Fomvasss\\LaravelStrTokens\\Facades\\StrToken"
            }
        }
    }
}
